[project]
title = Handle With Care
version = 0.70.0
dependencies#0 = https://github.com/britzl/deftest/archive/refs/tags/2.8.0.zip

[bootstrap]
main_collection = /main/main.collectionc
render = /builtins/render/default.renderc

[display]
width = 384
height = 216
update_frequency = 60
fullscreen = 1

[input]
game_binding = /input/game.input_bindingc

[collection_proxy]
max_count = 16

[sound]
max_component_count = 64

[html5]
heap_size = 64
scale_mode = stretch
show_fullscreen_button = 0
show_made_with_defold = 0
cssfile = /web/theme.css
