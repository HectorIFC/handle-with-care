# Menu-only horizontal navigation (level select, volume sliders). Bound to
# the arrows alone, never to A/D, so remapping a movement key can never also
# move a menu cursor. A level is not loaded while any menu is up, and the
# screens object returns false for everything but pause while one IS, so
# these never collide with the raw key_left/key_right above.
key_trigger {
  input: KEY_LEFT
  action: "move_left"
}
key_trigger {
  input: KEY_RIGHT
  action: "move_right"
}
