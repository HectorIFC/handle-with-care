# ONE ACTION PER KEY. Do not bind a key twice.
#
# Seven keys used to carry two actions each — KEY_LEFT raised both
# "key_left" (gameplay) and "move_left" (menu), KEY_UP raised both
# "key_up" and "menu_up", and so on. That made which one the engine
# actually delivers an implementation detail, and the player could not
# be moved with the arrow keys at all. Menus now translate the raw key
# actions themselves (see input_bindings.MENU), so nothing here has to
# be ambiguous.
#
# Gameplay movement is remapped at CONSUMPTION time, not here: Defold
# compiles this file into the build and has no runtime API to change
# it, so each physical key gets its own raw action name and
# main/core/input_bindings.lua decides what that key currently means.
#
# R, ESC and ENTER keep semantic names because they are never
# remappable: restart is broadcast to every restorable object in a
# level, and the menu must stay reachable no matter what the player
# rebinds.
key_trigger {
  input: KEY_A
  action: "key_a"
}
key_trigger {
  input: KEY_B
  action: "key_b"
}
