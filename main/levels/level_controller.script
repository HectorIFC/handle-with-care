-- Per-level controller (the "Game Manager" of PRD 9.2). Owns the one thing
-- no other object can know on its own: which level this is, and how long
-- the current attempt has run. Reports both to the save adapter, which is
-- what turns a win into progression (PRD 6.2).
--
-- Thin adapter (rule 1): it holds no progression rules — core/save.lua
-- decides what completing a level means. Time is accumulated from the
-- engine's own dt here rather than read from a clock inside core (rule 3).

go.property("level_number", 1)
-- Must be overridden per collection (component_properties) — see rule 5.
go.property("player", msg.url())
go.property("save_adapter", msg.url())
-- The screens object lives OUTSIDE this level's collection (it outlives
-- every level, since it owns the proxy that loads them), so it is addressed
-- by an absolute URL rather than a component_properties reference — a
-- collection loaded through a proxy cannot resolve a URL into its parent at
-- author time. Left as a property anyway so a test collection can point it
-- somewhere harmless.
go.property("screens", msg.url())

-- Exposed for tests and for the result screen (phase 11's remaining piece),
-- which needs the attempt's duration.
go.property("elapsed", 0)

local function start_attempt(self)
	self.elapsed = 0
	self.reported = false
	-- Counted here rather than read back from the save adapter: this is the
	-- attempt number for THIS visit to the level, which is what the result
	-- screen's "attempts" line means. The adapter's own running total
	-- survives across visits and is a different number.
	self.attempts = (self.attempts or 0) + 1
	msg.post(self.save_adapter, "level_started", { level = self.level_number })
end

function init(self)
	-- Which collection actually came up. Cheap, and the only thing that can
	-- tell a level apart from another once they are loaded: `make
	-- smoke-level LEVEL=N` fails unless this line reports N. Worth having in
	-- any log on its own terms, too.
	print("LEVEL-START " .. tostring(self.level_number))
	-- PRD 3.5: restart is broadcast through Defold's input dispatch, so this
	-- object acquires focus like every other restorable one — see
	-- player.script's on_input for why nobody consumes the action.
	msg.post(".", "acquire_input_focus")
	start_attempt(self)
end

function update(self, dt)
	if self.reported then
		return
	end

	local won = go.get(self.player, "won")
	local dead = go.get(self.player, "dead")

	if not won and not dead then
		-- Only counts time the player could actually act on: the clock
		-- stops the moment the attempt is decided, so a result screen left
		-- open doesn't inflate the recorded time.
		self.elapsed = self.elapsed + dt
		return
	end

	-- `reported` (not `won` alone) is what makes this fire exactly once:
	-- player.script's win flag is sticky, so without it this would post a
	-- completion every frame the player stands in the delivery zone.
	self.reported = true
	if won then
		msg.post(self.save_adapter, "level_completed", {
			level = self.level_number,
			time = self.elapsed,
		})
	end

	-- Tell the screens object to show the result (PRD 6.2). Posted for a
	-- loss too, not just a win: the result screen is how a player gets back
	-- to the menu or retries, and a death with no way out but the R key
	-- would be a dead end.
	msg.post(self.screens, "level_finished", {
		won = won,
		level = self.level_number,
		time = self.elapsed,
		attempts = self.attempts,
	})
end

function on_input(self, action_id, action)
	if action_id == hash("restart") and action.pressed then
		-- A restart is a new attempt, and PRD 6.2 counts attempts — so this
		-- re-reports level_started rather than just resetting the clock.
		start_attempt(self)
	end
	return false -- never consume: every other object needs to see this too
end

function on_message(self, message_id, message)
	if message_id == hash("reset") or message_id == hash("test_reset") then
		start_attempt(self)
	end
end
