-- Drives control inversion for level 7 "Control Freak". Thin adapter
-- (rule 1): core/input_inversion.lua owns the schedule and the transform.
--
-- Publishes `inverted` rather than reaching into the player: player.script
-- reads it synchronously (rule 4) and flips its own move_x. Keeping the
-- player as the one that applies it means input handling stays in one
-- place instead of two objects fighting over the same field.

local input_inversion = require "main.core.input_inversion"

-- Must be overridden per collection (component_properties) — see rule 5.
go.property("player", msg.url())

go.property("inverted_duration", 6.0)
go.property("normal_duration", 3.0)
-- When true, inversion tracks being airborne instead of a timer (PRD's
-- "inversão só no ar").
go.property("airborne_mode", false)
go.property("start_inverted", false)

-- Mirror for synchronous reads (rule 4).
go.property("inverted", false)

local function config(self)
	return {
		inverted_duration = self.inverted_duration,
		normal_duration = self.normal_duration,
		mode = self.airborne_mode and input_inversion.MODE_AIRBORNE
			or input_inversion.MODE_TIMED,
	}
end

local function reset(self)
	self.state = input_inversion.new(self.start_inverted)
	self.inverted = self.state.inverted
end

function init(self)
	-- PRD 3.5: restart is broadcast through Defold's input dispatch.
	msg.post(".", "acquire_input_focus")
	reset(self)
end

function update(self, dt)
	self.state = input_inversion.update(self.state, dt,
		go.get(self.player, "grounded"), config(self))
	self.inverted = self.state.inverted
end

function on_input(self, action_id, action)
	if action_id == hash("restart") and action.pressed then
		reset(self)
	end
	return false -- never consume: every other object needs to see this too
end

function on_message(self, message_id, message)
	if message_id == hash("reset") or message_id == hash("test_reset") then
		reset(self)
	end
end
