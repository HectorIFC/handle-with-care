-- Side-scrolling camera adapter. Thin wrapper over core/camera.lua (rule
-- 1): it reads the player's position, asks the core where to be, and moves
-- the render view. It owns no follow rules of its own.
--
-- Every object that needs to know where the camera is reads `x` from here
-- synchronously via go.get (rule 4) — the player and package both do, for
-- their camera-relative off-screen checks, and a message would put those a
-- frame behind the view they are being judged against.

local camera_core = require "main.core.camera"
local screen_shake = require "main.core.screen_shake"

-- Must be overridden per collection (component_properties) — see rule 5.
go.property("player", msg.url())

-- How wide this level actually is. The camera never scrolls past
-- level_width - screen_width, so a level that forgets to set this is
-- treated as one screen wide and simply never scrolls — the safe failure,
-- and exactly how the pre-camera levels behave.
go.property("level_width", 384)

go.property("dead_zone", 48)
go.property("follow_lerp", 0.12)

-- Screen shake (core/screen_shake.lua). Tunables live here so a level can
-- dial the whole effect down, or off, without touching the core defaults.
go.property("shake_decay", 1.8)
go.property("shake_max_offset", 6)
go.property("shake_frequency", 28)

-- Mirrors the camera's left edge in world space for synchronous reads.
go.property("x", 0)

local function config(self)
	return {
		screen_width = self.screen_width,
		level_width = self.level_width,
		dead_zone = self.dead_zone,
		follow_lerp = self.follow_lerp,
	}
end

function init(self)
	-- Same authoritative source the player and package already read rather
	-- than a duplicated constant (rule 5).
	self.screen_width = sys.get_config_int("display.width", 384)
	self.screen_height = sys.get_config_int("display.height", 216)

	-- Start already framing the player instead of easing in from 0, which
	-- would drag the view across the level on the first second of every
	-- attempt.
	local player_pos = go.get_position(self.player)
	local centered = player_pos.x - self.screen_width * 0.5
	self.state = camera_core.new(camera_core.clamp(centered, self.level_width, self.screen_width))
	self.shake = screen_shake.new()
	-- Accumulated dt, not a clock read (rule 3). Only ever feeds the shake's
	-- sine phase, so it never has to agree with anyone else's notion of time.
	self.time = 0
	self.x = self.state.x
	go.set_position(vmath.vector3(self.state.x, 0, 0))
end

function update(self, dt)
	local player_pos = go.get_position(self.player)
	self.state = camera_core.update(self.state, player_pos.x, dt, config(self))

	self.time = self.time + dt
	self.shake = screen_shake.update(self.shake, dt, { decay = self.shake_decay })
	local shake_x, shake_y = screen_shake.offset(self.shake, self.time, {
		max_offset = self.shake_max_offset,
		frequency = self.shake_frequency,
	})

	-- `x` publishes the camera's LOGICAL position, deliberately without the
	-- shake in it. Everything that reads it is making a gameplay judgement —
	-- the player's and package's off-screen death checks, and every parallax
	-- layer — and folding shake into those would make an explosion able to
	-- kill you, and would jitter the whole background.
	self.x = self.state.x

	-- Scrolling happens by handing the render script a VIEW MATRIX. Moving
	-- this game object does nothing on its own: there is no camera
	-- *component* here, and the stock render script only knows about a view
	-- it was given. An earlier comment in this file claimed moving the
	-- object was enough — it never was, and nobody could see it because
	-- input into a level was dead until phase 30, so no one ever walked far
	-- enough for the camera to matter.
	--
	-- The eye sits at the view's lower-left corner, which is what makes
	-- `x` mean "left edge of the view" for everyone who reads it: the
	-- player's and package's off-screen checks and every parallax layer.
	local eye_x = self.state.x + shake_x
	local eye_y = shake_y
	go.set_position(vmath.vector3(eye_x, eye_y, 0))
	msg.post("@render:", "set_view_projection", {
		-- `id` and `projection` are required by the message struct even
		-- though the stock render script routes every set_view_projection
		-- to its main camera and immediately overwrites the projection
		-- from use_fixed_fit_projection's own function. Omitting either is
		-- a runtime error, not a default.
		id = hash("camera"),
		projection = vmath.matrix4(),
		-- A pure X/Y translation, NOT matrix4_look_at. The sprites in this
		-- game sit at z from -0.9 (the sky layer) to 0.4 (an fx burst), and
		-- the projection's near/far is -1/1. A look_at view with the eye at
		-- z=1 subtracts 1 from every z, which pushed everything at z <= 0
		-- past the near plane: the whole level vanished and only the player
		-- and package (z 0.1 and 0.2) still drew. Leaving z untouched keeps
		-- every layer inside the frustum, and removes the question of which
		-- axis look_at points where.
		view = vmath.matrix4_translation(vmath.vector3(-eye_x, -eye_y, 0)),
	})
end

function on_message(self, message_id, message)
	if message_id == hash("shake") then
		-- Posted by player.script for every impact worth feeling. Trauma
		-- accumulates, so two hits in the same frame compose instead of one
		-- replacing the other.
		self.shake = screen_shake.add(self.shake, message.amount)
	elseif message_id == hash("reset") or message_id == hash("test_reset") then
		init(self)
	end
end
