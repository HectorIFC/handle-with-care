local player_movement = require "main.core.player_movement"
local knockback = require "main.core.knockback"
local hazards = require "main.core.hazards"
local offscreen_timer = require "main.core.offscreen_timer"
local camera = require "main.core.camera"
local input_bindings = require "main.core.input_bindings"

-- Defold hands on_input a hashed action_id, and input_bindings works in
-- plain strings (it is pure Lua and never sees an engine type, rule 1).
-- Built once here rather than hashing every candidate key on every input
-- event, and keyed by hash so the lookup is a single index.
local ACTION_NAMES = {}
for _, key in ipairs(input_bindings.KEYS) do
	ACTION_NAMES[hash(key)] = key
end

go.property("move_speed", 90)
go.property("gravity", -900)
go.property("jump_velocity", 320)
go.property("half_width", 8) -- must match player.collisionobject's box half-extent
go.property("half_height", 8)

-- Ground detection is a plain AABB check in Lua, not an engine physics
-- query. `physics.raycast`/`contact_point_response` were confirmed (via an
-- isolated, from-scratch reproduction) to never report a hit under this
-- project's headless test environment on this platform, so gameplay-
-- critical ground detection cannot depend on them — see CLAUDE.md. These
-- properties describe the level's base floor, the one surface that is
-- always present. Every OTHER walkable surface — static platforms, falling
-- platforms — registers itself instead (see "register_platform" in
-- on_message), which is what lets a level have any number of them.
go.property("ground_x_min", 128)
go.property("ground_x_max", 256)
go.property("ground_y_top", 48)

-- Mirrors self.state.facing/grounded so other objects (the package) can
-- read them synchronously via go.get(player_url, ...) — the same
-- synchronous-read approach as go.get_position, not a message (rule 4).
go.property("facing", 1)
go.property("grounded", true)

-- Discrete events (jumped, landed, changed direction) are posted to this
-- URL as messages — per-frame continuous state is polled (above), but
-- one-off events are messages, per CLAUDE.md rule 4. Must be overridden
-- per collection to point at the package this player is carrying.
go.property("package", msg.url())

-- The level's camera, when it has one. `has_camera` gates it because an
-- empty msg.url() is not a reliable "unset" sentinel to compare against —
-- the same reason phase 9a's extra_ground slot needed its own flag. A level
-- without a camera (test.collection, and any level narrower than the
-- screen) reports 0, which makes every camera-relative check identical to
-- the screen-relative one it replaced.
-- The level's gravity mood driver, when it has one (level 6). Gated by a
-- flag for the same reason has_camera is: an empty msg.url() is not a
-- reliable "unset" sentinel. A level without one reports 1.0, so every
-- other level's physics is untouched.
-- Level 7's control inversion, when the level has one. Same gating flag
-- reasoning as has_camera/has_gravity_mood.
go.property("has_input_inversion", false)
go.property("input_inversion", msg.url())

go.property("has_gravity_mood", false)
go.property("gravity_mood", msg.url())

-- The shared audio object, when the level wires one. Gated like every other
-- optional level object; without it, cue() is a no-op so the game is silent
-- but never errors.
go.property("has_audio", false)
go.property("audio", msg.url())

go.property("has_camera", false)
go.property("camera", msg.url())

-- The settings object that owns the player's key bindings (PRD 6.1's
-- "Controles"). Gated like every other optional wiring: without it the
-- player runs on input_bindings' defaults, which is exactly what
-- test.collection and any level that predates remapping want.
go.property("has_settings", false)
go.property("settings", msg.url())

-- A landing faster than this counts as a hard/heavy landing for the stress
-- system (PRD 4.5's "aterrissagem forte" / "queda de altura média/alta").
-- Set above a normal single jump's own return-fall speed (jump_velocity)
-- so routine jumps don't also trigger the heavier stress bump.
go.property("heavy_landing_velocity", 400)

-- PRD 4.6: Panic's random impulses knock the player back by this fraction
-- of the package's own impulse (15~30% — this project's chosen value).
go.property("knockback_percent", 0.2)
go.property("knockback_damping", 0.85)

-- Mirrors receipt of the package's "package_exploded" message (PRD 4.7) so
-- tests can verify the message actually arrives, the same way current_state/
-- detonated mirror package.script's own internal state for go.get reads.
-- A count, not a latch: a test covering re-arm (detonate, reset, detonate
-- again) needs to see the SECOND delivery too, not just "at least once
-- ever" — a boolean that's only ever set true can't tell those apart.
go.property("package_exploded_count", 0)

-- PRD 3.3/4.7's fail conditions, unified into one sticky flag: hazard
-- contact, a pit/off-world fall, the package exploding, or staying fully
-- off-screen too long all funnel through die() below. Once true, update()
-- freezes everything at the position/pose death happened at until the
-- player restarts (PRD 3.5, R).
go.property("dead", false)

-- PRD 3.4's win condition, posted by delivery_zone.script. Sticky and
-- freezing for the same reason `dead` is: the attempt is over either way,
-- and the only thing that clears it is a restart. Kept as its own flag
-- rather than reusing `dead` so a result screen (phase 11) can tell a win
-- from a loss without a second signal.
go.property("won", false)

-- PRD 3.3/4.7: "queda em buraco" — falling below this Y counts as a pit
-- death. A single world-bottom threshold rather than per-pit geometry:
-- this project has no camera/scrolling system yet, so "fell into a pit"
-- and "fell off the bottom of the world" are the same event for now (see
-- core/hazards.below_kill_plane).
go.property("kill_y", -20)

-- PRD 3.3: "pacote fugiu da tela" — no PRD-given threshold for "too long"
-- exists; matches core/offscreen_timer.lua's own DEFAULT_TIMEOUT, exposed
-- here as the tunable per rule 5.
go.property("offscreen_timeout", 2.0)

-- Applied where move_x is CONSUMED, not where it is recorded: the level's
-- inversion can flip mid-hold (timed) or the instant the player leaves the
-- ground (airborne), and a value baked in at key-press time would keep the
-- old direction until the key was released and pressed again.
local function effective_move_x(self)
	if not self.has_input_inversion then
		return self.input.move_x
	end
	if go.get(self.input_inversion, "inverted") then
		return -self.input.move_x
	end
	return self.input.move_x
end

local function mood_multiplier(self)
	if not self.has_gravity_mood then
		return 1
	end
	return go.get(self.gravity_mood, "multiplier")
end

-- Heavy/Light change the package's mass, which drags on the player's own
-- speed/jump/gravity (PRD 4.6) — read synchronously via go.get, same as
-- facing/grounded (rule 4).
local function movement_config(self)
	local mass = go.get(self.package, "mass")
	local speed_multiplier = player_movement.speed_multiplier(mass)
	local gravity_multiplier = player_movement.gravity_multiplier(mass)
	return {
		move_speed = self.move_speed * speed_multiplier,
		-- Level 6's mood multiplies the package's own Light/Heavy effect
		-- rather than replacing it, so a floaty mood while carrying a Light
		-- package compounds, which is the point of the level.
		gravity = self.gravity * gravity_multiplier * mood_multiplier(self),
		-- Its own multiplier, not the speed one: the PRD gives Heavy
		-- different penalties for speed (~35%) and jump height (~30%), and
		-- reusing the speed figure made Heavy nearly unjumpable.
		jump_velocity = self.jump_velocity * player_movement.jump_multiplier(mass),
	}
end

-- Read fresh every frame rather than cached: the camera moves, and an
-- off-screen judgement made against last frame's view would be wrong
-- exactly when the camera is scrolling fastest. Synchronous (rule 4).
local function cue(self, name)
	if self.has_audio then
		msg.post(self.audio, "play_cue", { cue = name })
	end
end

-- Impact feedback (core/screen_shake.lua). Routed through the player rather
-- than each source posting its own, because the player is the one object
-- that already holds the camera's URL and already sees every impact worth
-- feeling — hazards and the package report to it, not to the camera.
-- Spawns a burst at a world position. The factory lives on the player's own
-- .go rather than on a per-level FX object: the player is already the one
-- thing that sees every impact (hazards and the package report to it), so
-- this needs no new property and no change to any collection.
local BURST_TINTS = {
	land = vmath.vector4(1, 0.95, 0.75, 0.85),
	death = vmath.vector4(1, 0.4, 0.35, 1),
	explode = vmath.vector4(1, 0.65, 0.2, 1),
	win = vmath.vector4(0.6, 1, 0.75, 1),
}

local function burst(self, kind, scale)
	local pos = go.get_position()
	factory.create("#burst_factory", pos, nil, {
		tint = BURST_TINTS[kind] or BURST_TINTS.land,
		end_scale = scale or 1.8,
	})
end

local function shake(self, amount)
	if self.has_camera then
		msg.post(self.camera, "shake", { amount = amount })
	end
end

local function camera_x(self)
	if not self.has_camera then
		return 0
	end
	return go.get(self.camera, "x")
end

local function ground_rect(self)
	return { x_min = self.ground_x_min, x_max = self.ground_x_max, y_top = self.ground_y_top }
end

-- A registered platform's rect, converted from its live center position
-- (it can move — a falling platform drops) into the same static
-- { x_min, x_max, y_top } shape resting_y_on_ground expects. Read fresh
-- every frame, unlike the main ground_rect's fixed go.property values.
local function platform_rect(url)
	local pos = go.get_position(url)
	local half_width = go.get(url, "half_width")
	local half_height = go.get(url, "half_height")
	return { x_min = pos.x - half_width, x_max = pos.x + half_width, y_top = pos.y + half_height }
end

-- Unifies every PRD 3.3/4.7 fail condition (hazard contact, pit/off-world
-- fall, the package exploding, staying off-screen too long) into one
-- sticky flag and a single forward-declared message — mirrors
-- package_exploded's own no-listener-yet convention (phase 9b is the
-- real consumer).
local function die(self)
	if self.dead then
		return
	end
	self.dead = true
	msg.post(self.package, "player_died")
	cue(self, "player_death")
	shake(self, 0.55)
	burst(self, "death", 2.2)
	-- Played here rather than through apply_animation: update() early-returns
	-- once `dead` is set, so the normal per-frame animation path never runs
	-- again. The atlas plays this one ONCE and holds the last frame, which is
	-- what a frozen player needs — a looping death would twitch until restart.
	sprite.play_flipbook("#visual", "player_death")
	self.current_animation = "death"
end

-- Restores the whole attempt to its starting state (PRD 3.5: "quase
-- instantâneo... reinicia do início"). Shared by the R key and by tests'
-- "test_reset", so a restart and a test reset can never drift apart — a
-- field added to one is automatically cleared by the other.
local function reset(self)
	self.state = player_movement.new()
	self.input = { move_x = 0, jump_pressed = false }
	self.move_left_held = false
	self.move_right_held = false
	self.facing = self.state.facing
	self.grounded = self.state.grounded
	self.previous_facing = self.state.facing
	self.just_landed = false
	self.knockback = knockback.new()
	self.package_exploded_count = 0
	self.dead = false
	self.won = false
	self.offscreen = offscreen_timer.new()
	go.set_position(self.initial_position)
end

local function apply_animation(self)
	local anim = self.just_landed and "land" or player_movement.animation_state(self.state)
	if anim ~= self.current_animation then
		self.current_animation = anim
		-- One atlas image per state, named "player_<state>" — Defold turns a
		-- single-image atlas entry into a one-frame flipbook named after the
		-- file, so the state names in player_movement.animation_state are
		-- literally the animation names (see scripts/generate_sprites.py).
		sprite.play_flipbook("#visual", "player_" .. anim)
	end
	-- Flipping is checked every frame rather than inside the block above:
	-- facing changes while the animation name does not (running left and
	-- running right are both "run"), so gating it on an animation change
	-- would leave the sprite facing the wrong way for the whole run.
	if self.facing ~= self.current_flip then
		self.current_flip = self.facing
		sprite.set_hflip("#visual", self.facing < 0)
	end
end

function init(self)
	self.initial_position = go.get_position()
	-- Filled by "register_platform" messages that every walkable surface
	-- posts from its own init(). A message is right for this precisely
	-- because registration is a one-off discrete event; the per-frame
	-- position reads it enables stay synchronous go.get_position calls
	-- (rule 4), so no frame of lag is introduced where it would matter.
	self.platforms = {}
	self.state = player_movement.new()
	self.input = { move_x = 0, jump_pressed = false }
	self.move_left_held = false
	self.move_right_held = false
	self.just_landed = false
	self.current_animation = nil
	-- nil rather than 1 so the first apply_animation always publishes the
	-- flip, instead of assuming the sprite starts unflipped.
	self.current_flip = nil
	-- Defaults until (and unless) the settings object answers with the
	-- player's own bindings. A level with no settings wired keeps these
	-- forever, which is the intended behavior, not a fallback: WASD and the
	-- arrows both work out of the box.
	self.bindings = input_bindings.new()
	self.grounded = self.state.grounded
	self.previous_facing = self.state.facing
	self.knockback = knockback.new()
	self.offscreen = offscreen_timer.new()
	-- Read game.project's actual configured display size rather than
	-- duplicating it as a separate tunable default that could drift from
	-- it (rule 5) — sys.get_config_int is the single source of truth,
	-- shared with whatever the engine is actually rendering at.
	self.screen_width = sys.get_config_int("display.width", 384)
	self.screen_height = sys.get_config_int("display.height", 216)
	msg.post(".", "acquire_input_focus")
	-- Pull, rather than have the settings object push at us: only the
	-- player knows when it exists, and a level is proxy-loaded long after
	-- the settings object booted. The reply lands a frame or two later, and
	-- until then the defaults above are in force — harmless at level start,
	-- where the player is standing still by definition.
	if self.has_settings then
		msg.post(self.settings, "request_bindings")
	end
	apply_animation(self)
end

function update(self, dt)
	-- PRD 3.3/4.7 and 3.4: the attempt is over, win or lose — freeze exactly
	-- where/how it ended until the player restarts (PRD 3.5).
	if self.dead or self.won then
		return
	end

	local was_grounded = self.state.grounded
	local jumped_this_frame = was_grounded and self.input.jump_pressed

	local effective_input = {
		move_x = effective_move_x(self),
		jump_pressed = self.input.jump_pressed,
	}
	self.state = player_movement.update(self.state, effective_input, dt, movement_config(self))
	local velocity_y_before_landing = self.state.velocity_y

	self.knockback = knockback.decay(self.knockback, { damping = self.knockback_damping })

	local delta = player_movement.integrate(self.state, dt)
	local pos = go.get_position()
	local target_x = pos.x + delta.dx + self.knockback.velocity_x * dt
	local target_y = pos.y + delta.dy + self.knockback.velocity_y * dt

	local grounded = false
	local resting_y = player_movement.resting_y_on_ground(target_x, self.half_width, pos.y, target_y, self.half_height, ground_rect(self))
	-- Every platform that registered itself at init (see on_message's
	-- "register_platform"), checked in turn. Replaces phase 9a's single
	-- has_extra_ground/extra_ground slot, which could only ever hold one
	-- surface — a real level needs several, and go.property can't express
	-- a list.
	--
	-- is_falling is why every registered platform must expose that property
	-- (a static one is permanently false): an accelerating faller always
	-- eventually re-meets a constant-velocity one, so relying on geometry
	-- alone to "stop matching" isn't enough once a platform is dropping;
	-- see falling_platform.script's own comment for the chase-cycle this
	-- explicit exclusion prevents.
	if not resting_y then
		for _, platform in ipairs(self.platforms) do
			if not go.get(platform, "is_falling") then
				resting_y = player_movement.resting_y_on_ground(target_x, self.half_width, pos.y, target_y, self.half_height, platform_rect(platform))
				if resting_y then
					break
				end
			end
		end
	end
	if resting_y then
		target_y = resting_y
		grounded = true
	end

	go.set_position(vmath.vector3(target_x, target_y, pos.z))
	self.state = player_movement.set_grounded(self.state, grounded)
	self.just_landed = grounded and not was_grounded
	if self.just_landed then
		cue(self, "land")
	end
	self.facing = self.state.facing
	self.grounded = grounded

	if jumped_this_frame then
		msg.post(self.package, "player_jumped")
		cue(self, "jump")
	end
	if self.just_landed and math.abs(velocity_y_before_landing) >= self.heavy_landing_velocity then
		msg.post(self.package, "player_landed", { impact_velocity = velocity_y_before_landing })
		-- Scaled by how much the landing exceeded the threshold, capped by
		-- screen_shake's own saturation: a landing that barely qualifies
		-- should not hit as hard as a fall from the top of level 8.
		shake(self, 0.2 + 0.3 * math.min(1,
			(math.abs(velocity_y_before_landing) - self.heavy_landing_velocity) / self.heavy_landing_velocity))
		burst(self, "land", 1.4)
	end
	if self.facing ~= self.previous_facing then
		msg.post(self.package, "player_changed_direction")
		self.previous_facing = self.facing
	end

	if hazards.below_kill_plane(target_y, self.kill_y) then
		die(self)
	end

	local self_rect = { x = target_x, y = target_y, half_width = self.half_width, half_height = self.half_height }
	-- Camera-relative, not screen-relative (PRD 3.3's "pacote fugiu da
	-- tela"). Against a fixed screen rectangle, walking right to reach more
	-- of a wide level was indistinguishable from fleeing the play area,
	-- which is exactly why levels could never exceed one screen. A level
	-- with no camera reports 0 and behaves as it always did.
	local is_offscreen = camera.rect_offscreen(self_rect, camera_x(self), self.screen_width, self.screen_height)
	local offscreen_died
	self.offscreen, offscreen_died = offscreen_timer.update(self.offscreen, is_offscreen, dt, { timeout = self.offscreen_timeout })
	if offscreen_died then
		die(self)
	end

	apply_animation(self)

	self.input.jump_pressed = false
end

local function recompute_move_x(self)
	local move_x = 0
	if self.move_left_held and not self.move_right_held then
		move_x = -1
	elseif self.move_right_held and not self.move_left_held then
		move_x = 1
	end
	self.input.move_x = move_x
end

function on_input(self, action_id, action)
	-- The binding file names actions after physical keys, because Defold
	-- cannot rebind at runtime — so the first thing this does is ask what
	-- the pressed key currently MEANS. Note this is only about which key;
	-- level 7's control inversion still happens where move_x is consumed,
	-- not here, so "which key did they press" and "which direction does it
	-- produce right now" stay separate questions.
	local intent = input_bindings.resolve(self.bindings, ACTION_NAMES[action_id])
	if intent == "move_left" then
		self.move_left_held = not action.released
		recompute_move_x(self)
		return true
	elseif intent == "move_right" then
		self.move_right_held = not action.released
		recompute_move_x(self)
		return true
	elseif intent == "jump" and action.pressed then
		self.input.jump_pressed = true
		return true
	elseif action_id == hash("restart") and action.pressed then
		-- PRD 3.5. Deliberately NOT consumed (falls through to `return
		-- false` below): every object that needs restoring — the package,
		-- each hazard, the delivery zone — acquires input focus and handles
		-- this same action itself. Defold's input dispatch is the broadcast
		-- here, which is what lets a restart reach an arbitrary number of
		-- hazards without any of them being registered anywhere. Consuming
		-- it would silently leave every other object in its end-of-attempt
		-- state while only the player reset.
		reset(self)
	end
	-- "pause" is bound (see input/game.input_binding) but not handled here —
	-- left unconsumed for the pause menu (phase 11) once it exists.
	return false
end

function on_message(self, message_id, message, sender)
	if message_id == hash("register_platform") then
		-- The sender IS the registration — no URL needs to be authored on
		-- either side, so adding a platform to a level is just placing it.
		-- Every registered platform must expose half_width, half_height and
		-- is_falling (permanently false for a static one); update() reads
		-- all three each frame.
		table.insert(self.platforms, sender)
	elseif message_id == hash("set_bindings") then
		-- Sent by settings_adapter in reply to request_bindings, and again
		-- whenever the player changes a binding in the Options screen, so a
		-- remap applies to a level that is already running.
		self.bindings = message.bindings
	elseif message_id == hash("test_set_input") then
		self.input.move_x = message.move_x or 0
		self.input.jump_pressed = message.jump_pressed or false
	elseif message_id == hash("test_set_position") then
		-- Test-only: teleports the player and forces it airborne, so a
		-- test can produce a fall tall enough to exceed
		-- heavy_landing_velocity on impact — no ordinary jump does (a
		-- normal jump's return speed roughly equals its own launch
		-- velocity, well under the heavy-landing threshold), and there's
		-- no in-game way yet to gain that much height otherwise.
		local pos = go.get_position()
		go.set_position(vmath.vector3(message.x or pos.x, message.y or pos.y, pos.z))
		self.state = player_movement.set_grounded(self.state, false)
		self.grounded = self.state.grounded -- keep the go.property mirror in sync, same as test_reset does
	elseif message_id == hash("knockback") then
		self.knockback = knockback.apply(
			self.knockback,
			message.force_x * self.knockback_percent,
			message.force_y * self.knockback_percent
		)
	elseif message_id == hash("package_exploded") then
		self.package_exploded_count = self.package_exploded_count + 1
		-- On top of die()'s own shake, so a detonation saturates the trauma
		-- and hits harder than any other death. Composing rather than
		-- replacing is the reason screen_shake is trauma-based.
		shake(self, 0.45)
		burst(self, "explode", 3.0)
		-- PRD 4.7: the package exploding is one of the attempt's fail
		-- conditions — the player never drops the package, so its death
		-- kills the player too (see die()'s unified-flag comment).
		die(self)
	elseif message_id == hash("hazard_hit") then
		die(self)
	elseif message_id == hash("package_died") then
		-- The package's own pit/off-screen death (PRD 3.3/4.7 name the
		-- package explicitly for both) — same unification as
		-- package_exploded above.
		die(self)
	elseif message_id == hash("package_delivered") then
		-- PRD 3.4, posted by delivery_zone.script. Guarded like die(): the
		-- zone is already one-way, but a win arriving after a death must not
		-- overwrite the loss (or vice versa) — whichever landed first is the
		-- outcome of the attempt.
		if not self.dead and not self.won then
			self.won = true
		end
	elseif message_id == hash("reset") or message_id == hash("test_reset") then
		reset(self)
	end
end
