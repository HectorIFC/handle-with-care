-- Menu, level select, result and pause screens (PRD 6.1/6.2), plus the
-- collection proxy that loads and unloads the actual level.
--
-- Thin adapter (rule 1): every decision about which screen is active, what
-- a menu offers and where the cursor sits lives in core/screen_flow.lua.
-- This script draws that state into labels, owns the proxy, and turns key
-- presses into core calls.
--
-- It is the ONE object that stays loaded for the whole session — the level
-- comes and goes underneath it via the proxy — so it is also the natural
-- place to route "which level do I load next" decisions through.

local flow = require "main.core.screen_flow"
local save = require "main.core.save"
local input_bindings = require "main.core.input_bindings"
local audio_cues = require "main.core.audio_cues"
local rooms = require "main.core.rooms"

-- Same reverse map as player.script's: Defold delivers a hashed action_id
-- and input_bindings speaks plain strings. Needed here so the Controls
-- screen can tell WHICH key the player just pressed while capturing.
local KEY_NAMES = {}
for _, key in ipairs(input_bindings.KEYS) do
	KEY_NAMES[hash(key)] = key
end

-- Must be overridden per collection (component_properties) — see rule 5.
go.property("save_adapter", msg.url())
-- The game object holding one collectionproxy component per level, named
-- level_proxy_1, level_proxy_2, ... Levels are addressed by deriving the
-- fragment from the level number rather than authoring a URL per level:
-- Defold needs one proxy component per collection, so adding level N is
-- then just "add the component and the collection", with no adapter change.
go.property("loader", msg.url())
-- PRD 6.1's Opções needs somewhere to read and change gains.
go.property("settings_adapter", msg.url())

-- Mirrors the active screen for tests, the same go.property convention the
-- rest of the project uses for synchronous reads (rule 4).
go.property("screen", hash("menu"))
go.property("cursor", 1)
go.property("selected_level", 1)

-- Test-only: skips every collectionproxy message while still running the
-- full screen state machine. The shared test.collection has no proxy in it
-- (loading a whole level inside the fixture would duplicate the player and
-- package the other suites depend on), so without this a test that selects
-- "New Game" would post async_load into the void. What this cannot cover is
-- therefore the proxy itself — loading, enabling and time-stepping a real
-- level stays a manual-checklist item.
go.property("test_mode", false)

-- Mirrors the last proxy request a test suppressed, so a test can still
-- assert that selecting an entry WOULD have loaded the right level.
go.property("last_requested_level", 0)

-- The OS shortcut that actually toggles fullscreen. Asked here rather than
-- in screen_flow, which is pure and must never read the platform (rule 1).
local function fullscreen_hint()
	local system = sys.get_sys_info().system_name
	if system == "Darwin" then
		return "ctrl+cmd+F"
	end
	return "F11"
end

-- Fire-and-forget: the audio object is a sibling in this same collection,
-- so a bare path resolves. Guarded by the audio script's own pcall, so a
-- missing device never reaches here.
local function cue(name)
	msg.post("/audio#script", "play_cue", { cue = name })
end

-- Real randomness lives only in the adapter (rule 3) — screen_flow.quip
-- takes this as an injected rng and never calls math.random itself.
local function rng(min_value, max_value)
	return math.random(min_value, max_value)
end

local function entries_for(self)
	if self.state.screen == flow.MENU then
		return flow.menu_entries({ has_progress = go.get(self.save_adapter, "has_progress") })
	elseif self.state.screen == flow.PAUSED then
		return flow.pause_entries()
	elseif self.state.screen == flow.OPTIONS then
		return flow.options_entries(fullscreen_hint())
	elseif self.state.screen == flow.CONTROLS then
		return flow.controls_entries(input_bindings.ACTIONS)
	elseif self.state.screen == flow.CREDITS then
		return { { label = "Back", action = flow.ACTION_TO_MENU } }
	elseif self.state.screen == flow.RESULT then
		return flow.result_entries(
			{ total_levels = self.total_levels },
			self.result_level,
			self.result_won)
	end
	return {}
end

local function render(self)
	local lines = {}
	local title = ""

	if self.state.screen == flow.MENU then
		title = "HANDLE WITH CARE"
	elseif self.state.screen == flow.PAUSED then
		title = "PAUSED"
	elseif self.state.screen == flow.RESULT then
		title = self.result_won and "DELIVERED" or "FAILED"
		table.insert(lines, self.result_quip)
		table.insert(lines, "time " .. flow.format_time(self.result_time)
			.. "   attempts " .. tostring(self.result_attempts))
	elseif self.state.screen == flow.OPTIONS then
		title = "OPTIONS"
	elseif self.state.screen == flow.CONTROLS then
		title = "CONTROLS"
		if self.state.capturing then
			table.insert(lines, "press a key for "
				.. input_bindings.describe_action(self.state.capturing))
			table.insert(lines, "esc to cancel")
		elseif self.rebind_error then
			table.insert(lines, self.rebind_error)
		else
			table.insert(lines, "enter to rebind")
		end
		table.insert(lines, "")
	elseif self.state.screen == flow.CREDITS then
		title = "CREDITS"
		table.insert(lines, "Handle With Care")
		table.insert(lines, "design, code and everything else:")
		table.insert(lines, "Hector Cardoso")
		table.insert(lines, "")
		table.insert(lines, "built with Defold")
		table.insert(lines, "")
	elseif self.state.screen == flow.LEVEL_SELECT then
		title = "SELECT ROOM"
		local unlocked = go.get(self.save_adapter, "unlocked")
		-- A carousel: ONE theme per page. The flat list of forty numbers
		-- under eight headings did not fit 216px and overlapped itself into
		-- an unreadable pile — the exact overflow v0.59.0 flagged as
		-- unverifiable headless.
		local page = flow.theme_page(self.state.selected_level)
		local page_count = flow.theme_page(rooms.count())
		local theme = rooms.theme(rooms.ROOMS[self.state.selected_level].theme)
		table.insert(lines, string.format("THEME %d/%d - %s", page, page_count,
			theme and theme.name or "?"))
		table.insert(lines, "")
		local row = {}
		for index = (page - 1) * 5 + 1, math.min(page * 5, rooms.count()) do
			if index > unlocked then
				table.insert(row, " . ")
			elseif index == self.state.selected_level then
				table.insert(row, "[" .. index .. "]")
			else
				table.insert(row, " " .. index .. " ")
			end
		end
		table.insert(lines, table.concat(row))
		local selected = rooms.ROOMS[self.state.selected_level]
		table.insert(lines, selected.name or "")
		table.insert(lines, "")
		-- The prev/next buttons, each side drawn only when there is a page
		-- in that direction, with the key that operates it.
		local prev_button = page > 1 and "< W: PREV THEME" or ""
		local next_button = page < page_count and "S: NEXT THEME >" or ""
		table.insert(lines, prev_button .. "   " .. next_button)
	end

	for index, entry in ipairs(entries_for(self)) do
		local marker = (index == self.state.cursor) and "> " or "  "
		local text = entry.label
		-- An options row has to show its current value, or the player is
		-- adjusting something invisible.
		if entry.kind then
			text = text .. "  " .. flow.volume_bar(go.get(self.settings_adapter, entry.kind), 10)
		elseif entry.info then
			text = text .. "  " .. entry.info
		elseif entry.bind then
			-- A controls row: the entry's label is the raw action name, so
			-- both halves of the line come from input_bindings and cannot
			-- disagree with the rejection messages it produces.
			text = input_bindings.describe_action(entry.bind) .. "  "
			if self.state.capturing == entry.bind then
				text = text .. "..."
			else
				text = text .. input_bindings.describe_keys(self.bindings, entry.bind)
			end
		end
		table.insert(lines, marker .. text)
	end

	label.set_text("#title", title)
	label.set_text("#menu", table.concat(lines, "\n"))

	if self.state.screen == flow.PLAYING then
		label.set_text("#title", "")
		label.set_text("#menu", "")
		label.set_text("#hint", "")
	else
		label.set_text("#hint", "arrows: move   enter: select   esc: back")
	end

	self.screen = hash(self.state.screen)
	self.cursor = self.state.cursor
	self.selected_level = self.state.selected_level
end

-- The room proxy when a room is loaded, nil when the menu is showing.
--
-- The indirection survives the retirement of levels on purpose: the bug it
-- was born from (a finished room never unloaded because unload was guarded
-- by a LEVEL field, and Next Level then loading on top of it — two players
-- on screen) is exactly the kind that comes back when "what is loaded"
-- stops having one answer. Everything that unloads, pauses or retries goes
-- through here.
local function current_proxy(self)
	if self.current_room then
		local url = msg.url(self.loader)
		url.fragment = hash("room_proxy")
		return url
	end
	return nil
end

-- Rooms share one collection and therefore one proxy, unlike levels, which
-- need a proxy component each because each is its own collection. Which room
-- to build is posted AFTER enable rather than set as a property: the
-- collection's instances do not exist until the proxy is enabled, so there
-- is nothing to set a property on beforehand. Defold dispatches the two
-- messages in order, so room_builder exists by the time build_room lands.
local function load_room(self, index)
	self.current_room = index
	self.last_requested_room = index
	-- The same mirror the level path has always written. Now that the menu
	-- only ever loads rooms, "the thing the player last asked for" is one
	-- number, and keeping two of them is how a test ends up asserting the
	-- stale one. The name is historical; the meaning is the room index.
	self.last_requested_level = index
	if not self.test_mode then
		local proxy = msg.url(self.loader)
		proxy.fragment = hash("room_proxy")
		msg.post(proxy, "async_load")
		self.pending_room = index
	end
	self.state = flow.set_screen(self.state, flow.PLAYING)
	-- The theme's own track, with the same fallback the levels used: a
	-- theme without one plays the generic gameplay music rather than
	-- silence, which is the one bug nobody notices until playtest.
	local theme = rooms.theme(rooms.ROOMS[index] and rooms.ROOMS[index].theme)
	local track = theme and theme.music and ("music_" .. theme.music)
	cue((track and audio_cues.exists(track)) and track or "music_gameplay")
	render(self)
end

local function unload_current(self)
	-- The level's camera left a scrolled view behind on the render script,
	-- and the menu draws in plain screen coordinates. Without this, coming
	-- back from a level you had walked into would render the menu off to
	-- the side.
	msg.post("@render:", "set_view_projection",
		{ id = hash("camera"), view = vmath.matrix4(),
		  projection = vmath.matrix4() })
	local proxy = current_proxy(self)
	if proxy then
		if not self.test_mode then
			msg.post(proxy, "unload")
		end
		self.current_room = nil
	end
end

local function set_level_time_step(self, factor)
	-- Pause freezes the loaded collection's time step, which is the only
	-- thing that actually stops gameplay. Routed through current_proxy so it
	-- freezes a room too: while this only knew about levels, pausing inside
	-- a room did nothing at all.
	local proxy = current_proxy(self)
	if proxy and not self.test_mode then
		msg.post(proxy, "set_time_step", { factor = factor, mode = 0 })
	end
end

local function show_result(self, won)
	self.result_won = won
	-- Which room this was, so Retry and Next Level can act on the room
	-- rather than falling through to level 1. Captured BEFORE unload_current
	-- clears it.
	self.result_room = self.current_room
	self.result_level = self.current_room or 1
	self.result_time = self.pending_time or 0
	self.result_attempts = self.pending_attempts or 1
	self.result_quip = flow.quip(won, rng)
	cue(won and "music_win" or "music_gameover")
	unload_current(self)
	self.state = flow.set_screen(self.state, flow.RESULT)
	render(self)
end

local function perform(self, action)
	if action == flow.ACTION_NEW_GAME then
		msg.post(self.save_adapter, "new_game")
		load_room(self, 1)
	elseif action == flow.ACTION_CONTINUE then
		-- Resumes at the furthest level reached, which is what "Continuar"
		-- means to a player — not the last one they happened to replay.
		load_room(self, go.get(self.save_adapter, "unlocked"))
	elseif action == flow.ACTION_LEVEL_SELECT then
		self.state = flow.set_screen(self.state, flow.LEVEL_SELECT)
	elseif action == flow.ACTION_OPTIONS then
		self.state = flow.set_screen(self.state, flow.OPTIONS)
	elseif action == flow.ACTION_CREDITS then
		self.state = flow.set_screen(self.state, flow.CREDITS)
	elseif action == flow.ACTION_CONTROLS then
		self.rebind_error = nil
		self.state = flow.set_screen(self.state, flow.CONTROLS)
		-- Refresh rather than trust the cached copy: the settings file is
		-- the authority, and this screen is the only place it changes.
		msg.post(self.settings_adapter, "request_bindings")
	elseif action == flow.ACTION_REBIND then
		local entry = entries_for(self)[self.state.cursor]
		if entry and entry.bind then
			self.rebind_error = nil
			self.capture_pending = false
			self.state = flow.begin_capture(self.state, entry.bind)
		end
	elseif action == flow.ACTION_PLAY_LEVEL then
		load_room(self, self.state.selected_level)
	elseif action == flow.ACTION_RESUME then
		set_level_time_step(self, 1)
		self.state = flow.set_screen(self.state, flow.PLAYING)
	elseif action == flow.ACTION_RETRY then
		-- Reading result_room rather than current_room because show_result
		-- has already unloaded by now, and unloading is what clears
		-- current_room.
		local room = self.current_room or self.result_room or 1
		unload_current(self)
		load_room(self, room)
	elseif action == flow.ACTION_NEXT_LEVEL then
		local room = self.current_room or self.result_room or 1
		load_room(self, math.min(room + 1, rooms.count()))
	elseif action == flow.ACTION_TO_MENU then
		unload_current(self)
		cue("music_menu")
		self.state = flow.set_screen(self.state, flow.MENU)
	elseif action == flow.ACTION_QUIT then
		-- Guarded: a test selecting Quit would otherwise terminate the whole
		-- headless run, reporting as a mysterious mid-suite exit.
		if not self.test_mode then
			msg.post("@system:", "exit", { code = 0 })
		end
	end
	render(self)
end

-- The window may be any size — the game boots fullscreen (display.fullscreen
-- in game.project) and the player can leave fullscreen and drag it around —
-- but the WORLD stays 384x216. `use_fixed_fit_projection` is what makes that
-- work: the builtin render script takes the design resolution from
-- render.get_width() and the actual window from render.get_window_width(),
-- computes zoom = min(window/design) and centres the result.
--
-- Scaling the window this way rather than raising display.width/height is
-- not a preference: player.script, package.script and camera.script all read
-- sys.get_config_int("display.width") for their off-screen death checks, so
-- a bigger design resolution would widen the playable area and change
-- gameplay.
--
-- Smallest window the game may be squeezed into, as a multiple of the design
-- resolution. The UI font is 5x7 pixels; at 1x the menu and the package's
-- stress readout are unreadable on most monitors.
local MIN_WINDOW_SCALE = 2

local function enforce_minimum_window(self)
	local width, height = window.get_size()
	local min_width = self.design_width * MIN_WINDOW_SCALE
	local min_height = self.design_height * MIN_WINDOW_SCALE
	if width < min_width or height < min_height then
		-- This raises another RESIZED event, but the next pass is already at
		-- or above the minimum and does nothing, so it settles after one
		-- extra event rather than looping.
		window.set_size(math.max(width, min_width), math.max(height, min_height))
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	-- The collectionproxy components live on the `loader` object, and a
	-- proxy only forwards input into the collection it loaded if the object
	-- HOLDING it has input focus. The loader has no script of its own, so
	-- nobody was asking — which is why the level rendered and updated but
	-- the player's on_input never fired and the arrow keys did nothing.
	-- Acquired after this object, so a live level sees input first and the
	-- menu still gets whatever the level does not consume.
	msg.post(self.loader, "acquire_input_focus")

	-- Read rather than hardcoded, so the one authoritative resolution lives
	-- in game.project alone (rule 5).
	self.design_width = sys.get_config_int("display.width", 384)
	self.design_height = sys.get_config_int("display.height", 216)
	msg.post("@render:", "use_fixed_fit_projection", { near = -1, far = 1 })
	window.set_listener(function(this, event)
		if event == window.WINDOW_EVENT_RESIZED then
			enforce_minimum_window(this)
		end
	end)

	cue("music_menu")
	self.state = flow.new()
	self.total_levels = go.get(self.save_adapter, "total_levels")
	self.current_room = nil
	self.result_room = nil
	self.result_won = false
	self.result_level = 1
	self.result_time = 0
	self.result_attempts = 1
	self.result_quip = ""
	-- Defaults until the settings adapter answers. The Controls screen asks
	-- again every time it opens, so this only ever shows on a first frame.
	self.bindings = input_bindings.new()
	self.rebind_error = nil
	self.capture_pending = false
	msg.post(self.settings_adapter, "request_bindings")
	render(self)

	-- Diagnostic/coverage hook, off unless a settings override turns it on
	-- (see test/boot_level.settings and `make smoke-level`). Nothing
	-- automated loads a level collection otherwise — the gap that hid two
	-- boot-breaking bugs behind a fully green suite — so this is what lets
	-- the headless engine walk the async_load/enable path for real.
	local autoroom = sys.get_config_int("hwc.autostart_room", 0)
	if autoroom > 0 then
		print("AUTOSTART: loading room " .. autoroom)
		load_room(self, autoroom)
	end
end

-- The whole input reaction, as a plain local function. Deliberately NOT
-- left inside on_input: Defold's lifecycle callbacks are not reachable as
-- globals from another callback in the same script, so the test hook in
-- on_message calling on_input() directly failed with "attempt to call
-- global 'on_input' (a nil value)". Routing both the real keyboard and the
-- test hook through one local keeps them exercising identical logic, which
-- is the entire point of the hook.
local function handle_action(self, action_id)
	local screen = self.state.screen

	-- Capture mode swallows EVERYTHING before navigation gets a look in.
	-- Without this, binding Move Left to Down would also scroll the cursor,
	-- and binding it to Enter would confirm the next row on the way past.
	if self.state.capturing then
		if action_id == hash("pause") and not self.capture_pending then
			self.state = flow.cancel_capture(self.state)
			self.rebind_error = nil
			render(self)
			return true
		end
		local key = KEY_NAMES[action_id]
		if key and not self.capture_pending then
			msg.post(self.settings_adapter, "rebind",
				{ action = self.state.capturing, key = key })
			-- Capture is NOT ended here — it ends when the adapter answers
			-- (set_bindings or rebind_rejected). One physical key can raise
			-- two actions: Down produces both "key_down" (remappable) and
			-- "menu_down" (fixed menu navigation). Ending capture on the
			-- first would let the second through to scroll the cursor,
			-- which is precisely what capture exists to prevent. Staying in
			-- capture until the reply keeps swallowing them; the pending
			-- flag stops a second key from posting a second rebind.
			self.capture_pending = true
		end
		return true -- everything else is swallowed, not an escape hatch
	end

	-- Raw key -> the logical name the rest of this function already speaks.
	-- Done AFTER the capture block above, which needs the raw key so a
	-- player can rebind an action to an arrow or to Space. The test seam
	-- posts logical names, which are not in KEY_NAMES and so pass straight
	-- through untouched.
	local key = KEY_NAMES[action_id]
	local mapped = key and input_bindings.MENU[key]
	if mapped then
		action_id = hash(mapped)
	end

	if action_id == hash("pause") then
		if screen == flow.PLAYING then
			-- Freezing the loaded collection's time step is what actually
			-- pauses gameplay: every object in there keeps its own update()
			-- otherwise, and pausing by flag would mean touching every
			-- script instead of one proxy.
			set_level_time_step(self, 0)
			self.state = flow.set_screen(self.state, flow.PAUSED)
			render(self)
			return true
		elseif screen == flow.PAUSED then
			perform(self, flow.ACTION_RESUME)
			return true
		elseif screen == flow.CONTROLS then
			-- Back to Options, not to the menu: Controls is reached from
			-- there, and jumping two levels out would lose the player's
			-- place.
			self.rebind_error = nil
			self.state = flow.set_screen(self.state, flow.OPTIONS)
			render(self)
			return true
		elseif screen == flow.LEVEL_SELECT or screen == flow.OPTIONS
			or screen == flow.CREDITS then
			self.state = flow.set_screen(self.state, flow.MENU)
			render(self)
			return true
		end
		return false
	end

	if screen == flow.PLAYING then
		return false -- gameplay owns every other key while a level is live
	end

	if screen == flow.LEVEL_SELECT then
		if action_id == hash("menu_up") then
			self.state = flow.move_level_page(self.state, -1,
				{ total_levels = self.total_levels, unlocked = go.get(self.save_adapter, "unlocked") })
		elseif action_id == hash("menu_down") then
			self.state = flow.move_level_page(self.state, 1,
				{ total_levels = self.total_levels, unlocked = go.get(self.save_adapter, "unlocked") })
		elseif action_id == hash("move_left") then
			self.state = flow.move_level_cursor(self.state, -1,
				{ total_levels = self.total_levels, unlocked = go.get(self.save_adapter, "unlocked") })
		elseif action_id == hash("move_right") then
			self.state = flow.move_level_cursor(self.state, 1,
				{ total_levels = self.total_levels, unlocked = go.get(self.save_adapter, "unlocked") })
		elseif action_id == hash("confirm") then
			perform(self, flow.ACTION_PLAY_LEVEL)
			return true
		end
		render(self)
		return true
	end

	local entries = entries_for(self)

	-- Options sliders are adjusted with left/right on the highlighted row,
	-- so confirm stays free for the toggle and Back rows.
	if self.state.screen == flow.OPTIONS then
		local entry = entries[self.state.cursor]
		if entry and entry.kind and (action_id == hash("move_left") or action_id == hash("move_right")) then
			local delta = (action_id == hash("move_right")) and 0.1 or -0.1
			msg.post(self.settings_adapter, "adjust_volume", { kind = entry.kind, delta = delta })
			render(self)
			return true
		end
	end

	if action_id == hash("menu_up") then
		self.state = flow.move_cursor(self.state, -1, #entries)
		cue("ui_move")
	elseif action_id == hash("menu_down") then
		self.state = flow.move_cursor(self.state, 1, #entries)
		cue("ui_move")
	elseif action_id == hash("confirm") then
		local entry = entries[self.state.cursor]
		if entry then
			cue(entry.action == flow.ACTION_TO_MENU and "ui_back" or "ui_confirm")
			perform(self, entry.action)
		end
		return true
	else
		return false
	end

	render(self)
	return true
end

function on_input(self, action_id, action)
	-- Only acts on the press edge; holding a key must not scroll the menu.
	if not action.pressed and not action.repeated then
		return false
	end
	return handle_action(self, action_id)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("proxy_loaded") then
		msg.post(sender, "enable")
		if self.pending_room then
			-- Queued straight behind the enable, so it is dispatched once
			-- the collection's objects exist. This is the only way a room
			-- index can cross the proxy: there is nothing to set a property
			-- on until enable has run.
			msg.post("room:/room_builder#script", "build_room",
				{ index = self.pending_room })
			self.pending_room = nil
		end
		render(self)
	elseif message_id == hash("level_finished") then
		-- Posted by level_controller.script once the attempt is decided.
		-- The controller owns the timing; this screen only presents it.
		self.pending_time = message.time
		self.pending_attempts = message.attempts
		show_result(self, message.won)
	elseif message_id == hash("set_bindings") then
		-- The settings adapter's answer to request_bindings, and also what
		-- it sends after a successful rebind — so the screen only ever
		-- draws bindings that were actually accepted and written.
		self.bindings = message.bindings
		self.rebind_error = nil
		self.capture_pending = false
		self.state = flow.cancel_capture(self.state)
		render(self)
	elseif message_id == hash("rebind_rejected") then
		self.rebind_error = message.reason
		self.capture_pending = false
		self.state = flow.cancel_capture(self.state)
		render(self)
	elseif message_id == hash("test_input") then
		-- Test-only: headless has no way to inject a real key press, so this
		-- routes an action into the SAME handle_action() the keyboard reaches
		-- through on_input. Deliberately not a separate code path — a test
		-- that exercised its own copy of the navigation logic would prove
		-- nothing about what the keys actually do.
		handle_action(self, hash(message.action))
	elseif message_id == hash("test_set_screen") then
		-- Test-only: jumps straight to a screen without walking the menu,
		-- so a test can assert on one screen's behavior in isolation.
		self.state = flow.set_screen(self.state, message.screen)
		if message.won ~= nil then
			self.result_won = message.won
			self.result_level = message.level or 1
		end
		render(self)
	end
end
