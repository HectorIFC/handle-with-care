-- Menu, level select, result and pause screens (PRD 6.1/6.2), plus the
-- collection proxy that loads and unloads the actual level.
--
-- Thin adapter (rule 1): every decision about which screen is active, what
-- a menu offers and where the cursor sits lives in core/screen_flow.lua.
-- This script draws that state into labels, owns the proxy, and turns key
-- presses into core calls.
--
-- It is the ONE object that stays loaded for the whole session — the level
-- comes and goes underneath it via the proxy — so it is also the natural
-- place to route "which level do I load next" decisions through.

local flow = require "main.core.screen_flow"
local save = require "main.core.save"

-- Must be overridden per collection (component_properties) — see rule 5.
go.property("save_adapter", msg.url())
go.property("level_proxy", msg.url())

-- Mirrors the active screen for tests, the same go.property convention the
-- rest of the project uses for synchronous reads (rule 4).
go.property("screen", hash("menu"))
go.property("cursor", 1)
go.property("selected_level", 1)

-- Test-only: skips every collectionproxy message while still running the
-- full screen state machine. The shared test.collection has no proxy in it
-- (loading a whole level inside the fixture would duplicate the player and
-- package the other suites depend on), so without this a test that selects
-- "New Game" would post async_load into the void. What this cannot cover is
-- therefore the proxy itself — loading, enabling and time-stepping a real
-- level stays a manual-checklist item.
go.property("test_mode", false)

-- Mirrors the last proxy request a test suppressed, so a test can still
-- assert that selecting an entry WOULD have loaded the right level.
go.property("last_requested_level", 0)

-- Real randomness lives only in the adapter (rule 3) — screen_flow.quip
-- takes this as an injected rng and never calls math.random itself.
local function rng(min_value, max_value)
	return math.random(min_value, max_value)
end

local function entries_for(self)
	if self.state.screen == flow.MENU then
		return flow.menu_entries({ has_progress = go.get(self.save_adapter, "has_progress") })
	elseif self.state.screen == flow.PAUSED then
		return flow.pause_entries()
	elseif self.state.screen == flow.RESULT then
		return flow.result_entries(
			{ total_levels = self.total_levels },
			self.result_level,
			self.result_won)
	end
	return {}
end

local function render(self)
	local lines = {}
	local title = ""

	if self.state.screen == flow.MENU then
		title = "HANDLE WITH CARE"
	elseif self.state.screen == flow.PAUSED then
		title = "PAUSED"
	elseif self.state.screen == flow.RESULT then
		title = self.result_won and "DELIVERED" or "FAILED"
		table.insert(lines, self.result_quip)
		table.insert(lines, "time " .. flow.format_time(self.result_time)
			.. "   attempts " .. tostring(self.result_attempts))
	elseif self.state.screen == flow.LEVEL_SELECT then
		title = "SELECT LEVEL"
		local unlocked = go.get(self.save_adapter, "unlocked")
		local row = {}
		for level = 1, self.total_levels do
			if level > unlocked then
				table.insert(row, " . ")
			elseif level == self.state.selected_level then
				table.insert(row, "[" .. level .. "]")
			else
				table.insert(row, " " .. level .. " ")
			end
		end
		table.insert(lines, table.concat(row))
	end

	for index, entry in ipairs(entries_for(self)) do
		local marker = (index == self.state.cursor) and "> " or "  "
		table.insert(lines, marker .. entry.label)
	end

	label.set_text("#title", title)
	label.set_text("#menu", table.concat(lines, "\n"))

	if self.state.screen == flow.PLAYING then
		label.set_text("#title", "")
		label.set_text("#menu", "")
		label.set_text("#hint", "")
	else
		label.set_text("#hint", "arrows: move   enter: select   esc: back")
	end

	self.screen = hash(self.state.screen)
	self.cursor = self.state.cursor
	self.selected_level = self.state.selected_level
end

local function load_level(self, level)
	self.current_level = level
	self.last_requested_level = level
	if not self.test_mode then
		-- Only one level is ever loaded, so an unload of whatever came
		-- before must complete first — async_load's own "proxy_loaded" is
		-- what tells us it is safe to enable.
		msg.post(self.level_proxy, "async_load")
	end
	self.state = flow.set_screen(self.state, flow.PLAYING)
	render(self)
end

local function unload_level(self)
	if self.current_level then
		if not self.test_mode then
			msg.post(self.level_proxy, "unload")
		end
		self.current_level = nil
	end
end

local function set_level_time_step(self, factor)
	if not self.test_mode then
		msg.post(self.level_proxy, "set_time_step", { factor = factor, mode = 0 })
	end
end

local function show_result(self, won)
	self.result_won = won
	self.result_level = self.current_level or 1
	self.result_time = self.pending_time or 0
	self.result_attempts = self.pending_attempts or 1
	self.result_quip = flow.quip(won, rng)
	unload_level(self)
	self.state = flow.set_screen(self.state, flow.RESULT)
	render(self)
end

local function perform(self, action)
	if action == flow.ACTION_NEW_GAME then
		msg.post(self.save_adapter, "new_game")
		load_level(self, 1)
	elseif action == flow.ACTION_CONTINUE then
		-- Resumes at the furthest level reached, which is what "Continuar"
		-- means to a player — not the last one they happened to replay.
		load_level(self, go.get(self.save_adapter, "unlocked"))
	elseif action == flow.ACTION_LEVEL_SELECT then
		self.state = flow.set_screen(self.state, flow.LEVEL_SELECT)
	elseif action == flow.ACTION_PLAY_LEVEL then
		load_level(self, self.state.selected_level)
	elseif action == flow.ACTION_RESUME then
		set_level_time_step(self, 1)
		self.state = flow.set_screen(self.state, flow.PLAYING)
	elseif action == flow.ACTION_RETRY then
		local level = self.current_level or self.result_level or 1
		unload_level(self)
		load_level(self, level)
	elseif action == flow.ACTION_NEXT_LEVEL then
		load_level(self, math.min(self.result_level + 1, self.total_levels))
	elseif action == flow.ACTION_TO_MENU then
		unload_level(self)
		self.state = flow.set_screen(self.state, flow.MENU)
	elseif action == flow.ACTION_QUIT then
		-- Guarded: a test selecting Quit would otherwise terminate the whole
		-- headless run, reporting as a mysterious mid-suite exit.
		if not self.test_mode then
			msg.post("@system:", "exit", { code = 0 })
		end
	end
	render(self)
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.state = flow.new()
	self.total_levels = go.get(self.save_adapter, "total_levels")
	self.current_level = nil
	self.result_won = false
	self.result_level = 1
	self.result_time = 0
	self.result_attempts = 1
	self.result_quip = ""
	render(self)
end

-- The whole input reaction, as a plain local function. Deliberately NOT
-- left inside on_input: Defold's lifecycle callbacks are not reachable as
-- globals from another callback in the same script, so the test hook in
-- on_message calling on_input() directly failed with "attempt to call
-- global 'on_input' (a nil value)". Routing both the real keyboard and the
-- test hook through one local keeps them exercising identical logic, which
-- is the entire point of the hook.
local function handle_action(self, action_id)
	local screen = self.state.screen

	if action_id == hash("pause") then
		if screen == flow.PLAYING then
			-- Freezing the loaded collection's time step is what actually
			-- pauses gameplay: every object in there keeps its own update()
			-- otherwise, and pausing by flag would mean touching every
			-- script instead of one proxy.
			set_level_time_step(self, 0)
			self.state = flow.set_screen(self.state, flow.PAUSED)
			render(self)
			return true
		elseif screen == flow.PAUSED then
			perform(self, flow.ACTION_RESUME)
			return true
		elseif screen == flow.LEVEL_SELECT then
			self.state = flow.set_screen(self.state, flow.MENU)
			render(self)
			return true
		end
		return false
	end

	if screen == flow.PLAYING then
		return false -- gameplay owns every other key while a level is live
	end

	if screen == flow.LEVEL_SELECT then
		if action_id == hash("move_left") then
			self.state = flow.move_level_cursor(self.state, -1,
				{ total_levels = self.total_levels, unlocked = go.get(self.save_adapter, "unlocked") })
		elseif action_id == hash("move_right") then
			self.state = flow.move_level_cursor(self.state, 1,
				{ total_levels = self.total_levels, unlocked = go.get(self.save_adapter, "unlocked") })
		elseif action_id == hash("confirm") then
			perform(self, flow.ACTION_PLAY_LEVEL)
			return true
		end
		render(self)
		return true
	end

	local entries = entries_for(self)
	if action_id == hash("menu_up") then
		self.state = flow.move_cursor(self.state, -1, #entries)
	elseif action_id == hash("menu_down") then
		self.state = flow.move_cursor(self.state, 1, #entries)
	elseif action_id == hash("confirm") then
		local entry = entries[self.state.cursor]
		if entry then
			perform(self, entry.action)
		end
		return true
	else
		return false
	end

	render(self)
	return true
end

function on_input(self, action_id, action)
	-- Only acts on the press edge; holding a key must not scroll the menu.
	if not action.pressed and not action.repeated then
		return false
	end
	return handle_action(self, action_id)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("proxy_loaded") then
		msg.post(sender, "enable")
		render(self)
	elseif message_id == hash("level_finished") then
		-- Posted by level_controller.script once the attempt is decided.
		-- The controller owns the timing; this screen only presents it.
		self.pending_time = message.time
		self.pending_attempts = message.attempts
		show_result(self, message.won)
	elseif message_id == hash("test_input") then
		-- Test-only: headless has no way to inject a real key press, so this
		-- routes an action into the SAME handle_action() the keyboard reaches
		-- through on_input. Deliberately not a separate code path — a test
		-- that exercised its own copy of the navigation logic would prove
		-- nothing about what the keys actually do.
		handle_action(self, hash(message.action))
	elseif message_id == hash("test_set_screen") then
		-- Test-only: jumps straight to a screen without walking the menu,
		-- so a test can assert on one screen's behavior in isolation.
		self.state = flow.set_screen(self.state, message.screen)
		if message.won ~= nil then
			self.result_won = message.won
			self.result_level = message.level or 1
		end
		render(self)
	end
end
