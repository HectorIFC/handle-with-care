-- Persistence adapter for core/save.lua. This is the only place in the
-- project that touches a disk (rule 1): core/save.lua owns what a save
-- contains and how progression advances, and knows nothing about how it is
-- stored.
--
-- PRD 9.4 asks for LocalStorage on Web and a local file on Steam. Where the
-- bytes go is core/save_location.lua's decision, acted on by
-- main/ui/storage.lua (which this shares with settings_adapter): a Steam
-- build sets the `steam` property and saves route through Steam Cloud;
-- everything else uses sys.save, which Defold already maps onto
-- IndexedDB/localStorage in an HTML5 build and a real file on desktop.
--
-- Other objects talk to this through messages rather than requiring it, so
-- there is exactly one in-memory copy of the save and one writer. Reads are
-- answered by posting `save_state` back to the sender.

local save = require "main.core.save"
local rooms = require "main.core.rooms"
local storage = require "main.ui.storage"

-- PRD section 10 ships 10 levels. Exposed as a property so a test or a
-- future level pack can override it rather than editing this file (rule 5).
-- Rooms, not the ten legacy levels. Read from rooms.lua at init rather than
-- authored here, so adding a theme never means remembering to bump a count —
-- and save.lua already took this as a parameter, so nothing in the progress
-- format changes.
go.property("total_levels", 20)

-- Mirrors the in-memory state's headline values for synchronous go.get
-- reads, the same convention player.script uses for facing/grounded — a
-- menu asking "is level 3 unlocked?" shouldn't need a message round-trip.
go.property("unlocked", 1)
go.property("has_progress", false)
go.property("all_complete", false)
-- Career deaths and the completed set as a bitmask (bit N-1 = level N),
-- mirrored for synchronous go.get reads: go.property has no table type,
-- and the select screen needs the whole set every render.
go.property("total_deaths", 0)
go.property("completed_mask", 0)

-- Test-only: skips touching the real save file, so a test run can never
-- read or clobber the developer's own progress. Left as a property rather
-- than a #define so test.collection can set it explicitly (rule 5).
go.property("in_memory_only", false)

-- Set true only in a Steam build (component_properties), routing saves
-- through Steam Cloud. Off everywhere else — Web, editor, DRM-free desktop —
-- where sys.save already does the right thing. See core/save_location.lua.
go.property("steam", false)

local function publish(self)
	self.unlocked = self.state.unlocked
	self.has_progress = save.has_progress(self.state)
	self.all_complete = save.all_complete(self.state)
	self.total_deaths = self.state.deaths or 0
	self.completed_mask = save.completed_mask(self.state)
end

local function persist(self)
	if self.in_memory_only then
		return
	end
	-- sys.save returns false rather than erroring when the write fails
	-- (a full or read-only disk). Losing progress silently is the worst
	-- outcome here, so it is logged — but it is deliberately NOT fatal:
	-- a player mid-level should keep playing, not lose the session to a
	-- failed background write.
	if not storage.save("progress", self.state, self.steam) then
		print("WARNING: could not write save file; progress this session will not persist")
	end
end

function init(self)
	self.total_levels = rooms.count()
	if self.in_memory_only then
		self.state = save.new(self.total_levels)
	else
		-- sys.load returns an empty table when the file doesn't exist yet,
		-- which sanitize() turns into a fresh save — so first run and
		-- corrupt-file both land on a playable state with no special case.
		self.state = save.sanitize(storage.load("progress", self.steam), self.total_levels)
	end
	publish(self)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("level_started") then
		self.state = save.record_attempt(self.state, message.level)
		publish(self)
		persist(self)
	elseif message_id == hash("level_completed") then
		-- PRD 6.2: completing a level unlocks the next and saves
		-- automatically. `time` comes from the caller (rule 3 — this
		-- module reads no clock of its own).
		self.state = save.complete_level(self.state, message.level, message.time)
		publish(self)
		persist(self)
	elseif message_id == hash("record_death") then
		-- Posted by screens.script from the same branch that spends a life,
		-- so the two counters can never disagree about what a death is.
		self.state = save.record_death(self.state)
		publish(self)
		persist(self)
	elseif message_id == hash("new_game") then
		-- PRD 6.1: "Novo Jogo (apaga save e começa da Fase 1)".
		self.state = save.wipe(self.state)
		publish(self)
		persist(self)
	elseif message_id == hash("query_save") then
		-- Answers with the whole state for the level-select screen, which
		-- needs per-level completion and times, not just the mirrors above.
		msg.post(sender, "save_state", { state = self.state })
	end
end
