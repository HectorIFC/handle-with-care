local package_physics = require "main.core.package_physics"
local package_state_machine = require "main.core.package_state_machine"
local stress = require "main.core.stress"
local panic_impulse = require "main.core.panic_impulse"
local explosive = require "main.core.explosive"

go.property("offset_x", 8)
go.property("offset_y", 12)
go.property("lerp_factor", 0.35)
go.property("velocity_damping", 0.85)
-- Must be overridden per collection (component_properties) to point at the
-- player instance this package is attached to — see CLAUDE.md rule 5.
go.property("player", msg.url())

go.property("nervous_threshold", 30)
go.property("panic_threshold", 70)
go.property("explosive_threshold", 100)
go.property("nervous_shake_intensity", 0.5)
go.property("panic_shake_intensity", 1.0)
go.property("explosive_shake_intensity", 1.0)
go.property("explosive_time", 1.5)

go.property("stress_jump", 6)
go.property("stress_heavy_landing", 18)
go.property("stress_direction_change", 8)
go.property("stress_panic_per_sec", 14)
go.property("stress_decay_safe_per_sec", 6)

go.property("heavy_mass", 2.5)
go.property("light_mass", 0.4)
go.property("heavy_offset_y_bonus", -6)
go.property("light_offset_y_bonus", 6)
go.property("light_vertical_force", 40)

go.property("panic_impulse_interval", 0.55)
go.property("panic_horizontal_min", -120)
go.property("panic_horizontal_max", 120)
go.property("panic_vertical_min", 80)
go.property("panic_vertical_max", 160)
-- PRD 4.6: "aplica porcentagem das forças no personagem" (15~30%). The
-- package sends the player its *raw* impulse (below); how much of it
-- actually knocks the player back is player.script's own tunable
-- (knockback_percent), not duplicated here — see CLAUDE.md rule 5.

-- Mirrors self.machine/self.stress/mass so tests (and future observers,
-- e.g. player.script reading mass for its own speed/gravity multipliers)
-- can read them synchronously via go.get — same approach as player.script's
-- facing/grounded properties (rule 4).
go.property("current_state", hash("stable"))
go.property("current_stress", 0)
go.property("mass", 1.0)
-- Sticky, not a one-shot event: stays true after detonation so tests and
-- manual checks can just wait and read it, without needing to catch the
-- exact frame the timer crossed zero.
go.property("detonated", false)

local STATE_COLORS = {
	[package_state_machine.STABLE] = vmath.vector4(1, 1, 1, 1),
	[package_state_machine.NERVOUS] = vmath.vector4(1, 1, 0, 1),
	[package_state_machine.PANIC] = vmath.vector4(1, 0, 0, 1),
	[package_state_machine.EXPLOSIVE] = vmath.vector4(1, 0.5, 0, 1),
	[package_state_machine.HEAVY] = vmath.vector4(0.55, 0.4, 0.25, 1),
	[package_state_machine.LIGHT] = vmath.vector4(0.6, 0.85, 1, 1),
}
local DEFAULT_COLOR = vmath.vector4(1, 1, 1, 1)

-- Real randomness lives only in the adapter (rule 3) — core/panic_impulse.lua
-- takes this as an injected `rng` function and never calls math.random itself.
local function rng(min_value, max_value)
	return min_value + math.random() * (max_value - min_value)
end

local function movement_config(self)
	return {
		offset_x = self.offset_x,
		offset_y = self.offset_y,
		lerp_factor = self.lerp_factor,
		velocity_damping = self.velocity_damping,
	}
end

local function state_machine_config(self)
	return {
		nervous_threshold = self.nervous_threshold,
		panic_threshold = self.panic_threshold,
		explosive_threshold = self.explosive_threshold,
		nervous_shake_intensity = self.nervous_shake_intensity,
		panic_shake_intensity = self.panic_shake_intensity,
		explosive_shake_intensity = self.explosive_shake_intensity,
		heavy_mass = self.heavy_mass,
		light_mass = self.light_mass,
		heavy_offset_y_bonus = self.heavy_offset_y_bonus,
		light_offset_y_bonus = self.light_offset_y_bonus,
		light_vertical_force = self.light_vertical_force,
	}
end

local function stress_config(self)
	return {
		stress_jump = self.stress_jump,
		stress_heavy_landing = self.stress_heavy_landing,
		stress_direction_change = self.stress_direction_change,
		stress_panic_per_sec = self.stress_panic_per_sec,
		stress_decay_safe_per_sec = self.stress_decay_safe_per_sec,
	}
end

local function panic_impulse_config(self)
	return {
		interval = self.panic_impulse_interval,
		horizontal_min = self.panic_horizontal_min,
		horizontal_max = self.panic_horizontal_max,
		vertical_min = self.panic_vertical_min,
		vertical_max = self.panic_vertical_max,
	}
end

local function explosive_config(self)
	return {
		explosive_time = self.explosive_time,
	}
end

-- Continuous (per-frame) stress: Panic accumulates on its own; otherwise it
-- decays while the player is grounded and safe. Discrete events (jump,
-- landing, direction change) are applied immediately in on_message instead.
-- Explosive freezes stress entirely: once detonation is inevitable, the
-- countdown alone decides the outcome, and letting stress keep decaying
-- would drop it below explosive_threshold on the very next frame — harmless
-- to the (now sticky) state itself, but confusing on the stress HUD and
-- pointless to compute.
local function accumulate_continuous_stress(self, dt)
	if self.machine.current_state == package_state_machine.PANIC then
		self.stress = stress.apply_panic(self.stress, dt, stress_config(self))
	elseif self.machine.current_state == package_state_machine.EXPLOSIVE then
		-- frozen, see comment above
	elseif go.get(self.player, "grounded") then
		self.stress = stress.decay_safe(self.stress, dt, stress_config(self))
	end
end

local function apply_hud(self)
	local state_name = self.machine.current_state
	local stress_rounded = math.floor(self.stress.value + 0.5)
	local text = "[" .. state_name .. " " .. stress_rounded .. "]"
	if self.detonated then
		text = text .. " BOOM"
	end
	label.set_text("#visual", text)
	go.set("#visual", "color", STATE_COLORS[state_name] or DEFAULT_COLOR)
	self.current_state = hash(state_name)
	self.current_stress = self.stress.value
	self.mass = package_state_machine.mass(self.machine, state_machine_config(self))
end

function init(self)
	self.time = 0
	local pos = go.get_position()
	self.physics = package_physics.new(pos.x, pos.y)
	self.machine = package_state_machine.new()
	self.stress = stress.new()
	self.panic_impulse = panic_impulse.new()
	self.explosive = explosive.new()
	apply_hud(self)
end

function update(self, dt)
	self.time = self.time + dt

	accumulate_continuous_stress(self, dt)

	local was_panic = self.machine.current_state == package_state_machine.PANIC
	self.machine = package_state_machine.update_from_stress(self.machine, self.stress.value, state_machine_config(self))
	local is_panic = self.machine.current_state == package_state_machine.PANIC
	local is_exploding = self.machine.current_state == package_state_machine.EXPLOSIVE

	if is_panic then
		if not was_panic then
			self.panic_impulse = panic_impulse.new() -- fresh timer entering Panic
		end
		local triggered
		self.panic_impulse, triggered = panic_impulse.update(self.panic_impulse, dt, rng, panic_impulse_config(self))
		if triggered then
			-- PRD 4.6: a percentage of this same impulse also knocks the
			-- player back — player.script owns how much (knockback_percent).
			msg.post(self.player, "knockback", {
				force_x = self.panic_impulse.horizontal_force,
				force_y = self.panic_impulse.vertical_force,
			})
		end
	else
		self.panic_impulse = panic_impulse.new()
	end

	if is_exploding then
		-- Can't detect "just entered" the way Panic does (comparing this
		-- state to the value read before update_from_stress ran): Explosive
		-- can also be entered directly by debug_set_state/a future
		-- phase-timer trigger, whose on_message mutation already happened
		-- *before* this update() call even started, so a before/after
		-- comparison taken inside update() would never see a transition.
		-- Checking the timer itself works for either entry path and can't
		-- misfire on a later frame: timer <= 0 is also true right after
		-- detonation, but `detonated` (sticky) rules that case out.
		if self.explosive.timer <= 0 and not self.detonated then
			self.explosive = explosive.start(explosive_config(self))
		end
		local detonated
		self.explosive, detonated = explosive.update(self.explosive, dt)
		if detonated then
			self.detonated = true
			-- PRD 4.7: explosive_timer reaching zero is a death condition.
			-- No listener exists yet (hazard/death handling arrives with
			-- phase 9a/9b) — this is the same forward-declared convention
			-- as player_jumped/player_landed before anything consumed them.
			msg.post(self.player, "package_exploded")
		end
	end

	local player_pos = go.get_position(self.player)
	local player = {
		x = player_pos.x,
		y = player_pos.y,
		facing = go.get(self.player, "facing"),
	}
	local sm_config = state_machine_config(self)
	local shake_intensity = package_state_machine.shake_intensity(self.machine, sm_config)
	if is_exploding then
		-- Ramps shake from 0 up to the state's ceiling as detonation
		-- approaches (PRD 4.4: "shake aumenta"), instead of snapping to
		-- full intensity the instant Explosive is entered.
		shake_intensity = shake_intensity * explosive.progress(self.explosive, explosive_config(self))
	end
	local package_state = {
		shake_intensity = shake_intensity,
		horizontal_force = self.panic_impulse.horizontal_force,
		vertical_force = package_state_machine.vertical_force(self.machine, sm_config) + self.panic_impulse.vertical_force,
		offset_y_bonus = package_state_machine.offset_y_bonus(self.machine, sm_config),
	}

	self.physics = package_physics.update(self.physics, player, package_state, self.time, movement_config(self))

	local pos = go.get_position()
	go.set_position(vmath.vector3(self.physics.position_x, self.physics.position_y, pos.z))

	apply_hud(self)
end

function on_message(self, message_id, message)
	if message_id == hash("player_jumped") then
		self.stress = stress.apply_jump(self.stress, stress_config(self))
	elseif message_id == hash("player_landed") then
		self.stress = stress.apply_heavy_landing(self.stress, stress_config(self))
	elseif message_id == hash("player_changed_direction") then
		self.stress = stress.apply_direction_change(self.stress, stress_config(self))
	elseif message_id == hash("test_reset") then
		self.machine = package_state_machine.new()
		self.stress = stress.new()
		self.panic_impulse = panic_impulse.new()
		self.explosive = explosive.new()
		self.detonated = false
		-- Panic/Explosive can leave residual velocity in self.physics
		-- (decayed but nonzero); left alone it would bleed into whatever
		-- runs next.
		self.physics.velocity_x = 0
		self.physics.velocity_y = 0
	elseif message_id == hash("debug_set_state") then
		-- Manual/test override for the NON-ladder states (message.state,
		-- e.g. "heavy") — this is how Heavy/Light are entered for now. A
		-- real per-level trigger (cyclic timer for Heavy Duty, phase 13)
		-- replaces this later; this hook stays useful for manual testing
		-- and debugging regardless.
		--
		-- Does NOT stick for Stable/Nervous/Panic: update_from_stress()
		-- re-derives those from self.stress every single frame (that's the
		-- whole point of the ladder), so it overwrites this again on the
		-- very next update(). Use debug_set_stress below to reach those
		-- states instead. Explosive is the one ladder-adjacent exception —
		-- it's deliberately excluded from that re-derivation (see
		-- RE_DERIVABLE_STATES in package_state_machine.lua), so setting it
		-- here does stick, the same as Heavy/Light — this is also exactly
		-- how a future phase-timer trigger (e.g. Hot Potato) is expected
		-- to force Explosive without going through stress at all.
		self.machine = package_state_machine.set_state(self.machine, message.state)
	elseif message_id == hash("debug_set_stress") then
		-- Manual/test override for the stress value itself — the way to
		-- reach Nervous/Panic/Explosive on demand, since those states are
		-- always re-derived from stress (see debug_set_state above).
		self.stress = stress.set(message.value)
	end
end
