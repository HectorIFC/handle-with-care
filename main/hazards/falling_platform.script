-- Falling platform adapter (roadmap phase 9a: "plataformas que caem").
-- Acts as solid ground (the player's own script checks this instance via
-- its optional extra_ground slot) until the player has stood on it for
-- fall_delay seconds, then it genuinely falls.
--
-- is_falling is an explicit, permanent exclusion, not just a side effect
-- of the platform moving away: relying on geometric divergence alone is
-- wrong, because the player's fall accelerates (gravity) while the
-- platform's own fall is constant-velocity (fall_speed) — an accelerating
-- faller always eventually catches up to a constant-velocity one. Without
-- this flag, resting_y_on_ground would re-match the platform mid-chase,
-- re-grounding the player for one frame (zeroing velocity_y), which then
-- free-falls and re-catches it again, repeating — each catch a fresh
-- just_landed/potential heavy-landing event, worse the longer both keep
-- falling. Once is_falling is true, player.script skips this instance
-- entirely, so the player free-falls to the real ground exactly once.

local falling_platform = require "main.core.falling_platform"
local hazards = require "main.core.hazards"

go.property("half_width", 32)
go.property("half_height", 8)
-- Must be overridden per collection (component_properties) to point at
-- this level's player instance — see CLAUDE.md rule 5.
go.property("player", msg.url())
go.property("fall_delay", 1.0)
-- Lowered from 200. At 200 the platform left the screen almost the instant
-- it let go, so the drop read as the platform vanishing rather than as
-- something you might still scramble off. Slower is also more legible:
-- PRD section 11 asks that a death be understandable within two seconds,
-- and you cannot learn from a hazard you never saw move.
go.property("fall_speed", 150)
go.property("is_falling", false)

-- The pre-fall shudder. Exposed as properties, like every other tunable, so
-- a level can dial it without touching the core defaults (rule 5).
go.property("wobble_amplitude", 2.0)
go.property("wobble_frequency", 16.0)

-- tile_platform.png's native size; see main/level/platform.script.
local TILE = 16

function init(self)
	self.initial_position = go.get_position()
	self.platform = falling_platform.new()
	-- PRD 3.5: restart is broadcast through Defold's input dispatch rather
	-- than a registry of hazards to notify — see player.script's on_input.
	msg.post(".", "acquire_input_focus")
	-- Registers as a walkable surface, exactly like a static platform does
	-- (main/level/platform.script) — the player skips it while is_falling.
	msg.post(self.player, "register_platform")

	-- Same derivation as platform.script: the drawn size comes from the
	-- half-extents the AABB check already uses, so the two can't drift.
	go.set_scale(vmath.vector3(
		self.half_width * 2 / TILE,
		self.half_height * 2 / TILE,
		1))
end

function update(self, dt)
	local pos = go.get_position()
	local player_pos = go.get_position(self.player)
	local player_rect = {
		x = player_pos.x,
		y = player_pos.y,
		half_width = go.get(self.player, "half_width"),
		half_height = go.get(self.player, "half_height"),
	}
	local self_rect = { x = pos.x, y = pos.y, half_width = self.half_width, half_height = self.half_height }

	local is_standing_on = hazards.standing_on(player_rect, self_rect)
	self.platform = falling_platform.update(self.platform, is_standing_on, dt, { fall_delay = self.fall_delay })
	self.is_falling = self.platform.falling

	if self.platform.falling then
		go.set_position(vmath.vector3(pos.x, pos.y - self.fall_speed * dt, pos.z))
		return
	end

	-- Wobble is measured from the platform's HOME x, never added to wherever
	-- it happens to be: adding a per-frame offset to the live position would
	-- integrate the sine instead of tracing it, and the platform would walk
	-- off sideways over a few seconds.
	go.set_position(vmath.vector3(
		self.initial_position.x + falling_platform.wobble_offset(self.platform, {
			fall_delay = self.fall_delay,
			wobble_amplitude = self.wobble_amplitude,
			wobble_frequency = self.wobble_frequency,
		}),
		pos.y, pos.z))
end

local function reset(self)
	self.platform = falling_platform.new()
	self.is_falling = false
	go.set_position(self.initial_position)
end

function on_input(self, action_id, action)
	if action_id == hash("restart") and action.pressed then
		reset(self)
	end
	return false -- never consume: every other object needs to see this too
end

function on_message(self, message_id, message)
	if message_id == hash("reset") or message_id == hash("test_reset") then
		reset(self)
	end
end
