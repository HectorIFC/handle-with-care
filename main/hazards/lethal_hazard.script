-- Shared adapter for every instantly-lethal hazard type (PRD 4.7: "contato
-- com spike, serra"). Spikes and saws are mechanically identical — contact
-- with either the player or the package kills — so one script covers both;
-- the visual distinction (PRD 7.1: saws rotate, spikes do not) is the
-- `variant` property picking an image and a spin, never separate scripts or
-- different hitboxes. Also pulls
-- itself toward the package while it's Magnetized (PRD Level 5 "Magnet
-- Madness" names spikes/serras specifically, not falling platforms — see
-- CLAUDE.md's Magnetized note for why this wiring was deferred to phase 9a).
--
-- Inverted from every other overlap check in this project: instead of the
-- player enumerating every hazard in a level (Defold's go.property can't
-- express "an arbitrary number of other instances"), each hazard checks
-- itself against the one well-known player/package pair. This scales to
-- any number of hazards without a registry.

local hazards = require "main.core.hazards"
local magnetism = require "main.core.magnetism"

go.property("half_width", 8)
go.property("half_height", 8)
-- Must be overridden per collection (component_properties) to point at
-- this level's player/package instances — see CLAUDE.md rule 5.
go.property("player", msg.url())
go.property("package", msg.url())

-- PRD 4.5: "perto de spike/serra" builds stress even before contact. No
-- PRD value exists for how close counts as "near" (only the per-second
-- rate, stress.lua's stress_near_hazard_per_sec) — this is this project's
-- own initial guess, same as magnetism.lua's DEFAULT_STRENGTH.
go.property("near_margin", 24)

-- "spike" or "saw" (PRD 7.1). Visual only — both kill on contact and both
-- build stress within near_margin, exactly as before.
go.property("variant", hash("spike"))
-- Degrees per second, saws only. Visual, so it is never fed into the AABB:
-- the hazard's hitbox stays the axis-aligned half_width/half_height box
-- whatever the sprite is doing.
go.property("spin_speed", 220)

local function rect_for(url, half_width, half_height)
	local pos = go.get_position(url)
	return { x = pos.x, y = pos.y, half_width = half_width, half_height = half_height }
end

-- spike.png / saw.png native size (both 16x16).
local SPRITE_SIZE = 16

-- PRD 7.1 lists spikes and saws as visually distinct, with saws rotating.
-- They stay mechanically identical — one script, one AABB, one lethal
-- contact — because the PRD gives them no different behavior. This is
-- purely which image is played and whether it spins.
local SAW = hash("saw")
local IMAGE = { [hash("spike")] = "spike", [SAW] = "saw" }

function init(self)
	self.initial_position = go.get_position()
	-- PRD 3.5: restart is broadcast through Defold's input dispatch rather
	-- than a registry of hazards to notify — see player.script's on_input.
	-- This is what lets a level hold any number of hazards and still have
	-- all of them restored by one key press.
	msg.post(".", "acquire_input_focus")

	-- spike.png is authored at the hazard's default half-extents, so this
	-- resolves to scale 1 unless a level overrides them — deriving it
	-- anyway keeps the picture honest if one ever does.
	go.set_scale(vmath.vector3(
		self.half_width * 2 / SPRITE_SIZE,
		self.half_height * 2 / SPRITE_SIZE,
		1))
	sprite.play_flipbook("#visual", IMAGE[self.variant] or "spike")
	self.angle = 0
end

function on_input(self, action_id, action)
	if action_id == hash("restart") and action.pressed then
		go.set_position(self.initial_position)
	end
	return false -- never consume: every other object needs to see this too
end

function update(self, dt)
	if self.variant == SAW then
		-- Visual only, and applied to rotation rather than to the rect the
		-- overlap check builds below: a spinning hitbox would make the same
		-- approach lethal or safe depending on the frame, which is exactly
		-- the kind of unreadable death PRD section 11 rules out.
		self.angle = (self.angle + self.spin_speed * dt) % 360
		go.set_rotation(vmath.quat_rotation_z(math.rad(self.angle)))
	end

	if go.get(self.package, "current_state") == hash("magnetized") then
		local package_pos = go.get_position(self.package)
		local pos = go.get_position()
		local config = {
			radius = go.get(self.package, "magnet_radius"),
			strength = go.get(self.package, "magnet_strength"),
		}
		local force = magnetism.attraction_force(package_pos.x, package_pos.y, pos.x, pos.y, config)
		go.set_position(vmath.vector3(pos.x + force.x * dt, pos.y + force.y * dt, pos.z))
	end

	local self_rect = rect_for(".", self.half_width, self.half_height)
	local player_rect = rect_for(self.player, go.get(self.player, "half_width"), go.get(self.player, "half_height"))
	local package_rect = rect_for(self.package, go.get(self.package, "half_width"), go.get(self.package, "half_height"))

	local near_rect = {
		x = self_rect.x,
		y = self_rect.y,
		half_width = self.half_width + self.near_margin,
		half_height = self.half_height + self.near_margin,
	}
	if hazards.rect_overlap(near_rect, player_rect) or hazards.rect_overlap(near_rect, package_rect) then
		msg.post(self.package, "near_hazard", { dt = dt })
	end

	if hazards.rect_overlap(self_rect, player_rect) then
		msg.post(self.player, "hazard_hit")
		return
	end

	if hazards.rect_overlap(self_rect, package_rect) then
		msg.post(self.player, "hazard_hit")
	end
end

function on_message(self, message_id, message)
	if message_id == hash("test_reset") then
		-- A prior test's Magnetized attraction can have moved this
		-- instance; restore it so the next test starts from a known rect.
		go.set_position(self.initial_position)
	elseif message_id == hash("test_set_position") then
		-- Test-only: lets a specific test bring a hazard within
		-- magnet_radius on demand, without changing this instance's
		-- default spawn point — which stays deliberately OUTSIDE the
		-- radius so every other suite (anything that debug-sets
		-- Magnetized without expecting a hazard nearby) isn't at risk of
		-- this hazard drifting into contact mid-test. See CLAUDE.md's
		-- Magnetized/hazards note.
		local pos = go.get_position()
		go.set_position(vmath.vector3(message.x or pos.x, message.y or pos.y, pos.z))
	end
end
